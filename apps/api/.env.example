# Copy to .env — real values never enter the repository.
# Local values match docker-compose.yml. Each setting is checked at startup once the code uses it.

# --- Server ---
NODE_ENV=development
PORT=3001

# --- Database: the API's limited key, then the owner key for migrations ---
# On Neon the API's key goes to Render and the owner key to GitHub's secrets, never in this file.
# Their endings differ: the API's driver and Prisma's migration tool read TLS settings differently.
#   DATABASE_URL            efactura_app on the -pooler host, ending ?sslmode=verify-full
#   MIGRATION_DATABASE_URL  the owner on the direct host, ending ?sslmode=require&channel_binding=require&sslaccept=strict
DATABASE_URL=postgresql://efactura_app:efactura_app@localhost:5432/efactura
MIGRATION_DATABASE_URL=postgresql://efactura:efactura@localhost:5432/efactura

# --- Queue ---
REDIS_URL=redis://localhost:6380

# --- Login: 32+ random characters each; Render generates its own ---
# node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET=
INTERNAL_API_KEY=
LINK_SECRET=

# --- Email: Mailpit on the PC, Resend in production ---
# Resend: smtps://resend:<API key>@smtp.resend.com:465
# 127.0.0.1, not localhost: Nodemailer's own DNS lookup of localhost can hang 20 s on Windows
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM="eFactura <no-reply@efactura.local>"
APP_URL=http://localhost:3000
# Optional: every email goes to this address instead — for Resend's test sender, before the domain
# EMAIL_REDIRECT_TO=you@example.com

# --- AI reading ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- File storage: S3Proxy from docker-compose.yml on the PC, Cloudflare R2 in production ---
# R2: S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com and a token limited to the bucket
S3_ENDPOINT=http://localhost:8080
S3_BUCKET=efactura
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local-secret
